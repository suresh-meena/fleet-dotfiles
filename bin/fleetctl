def local_target_template(name: str) -> str:
    """Return a starter target file that keeps secrets elsewhere."""
    return f"""\
version = 1
name = "{name}"
enabled = true
transport = "ssh"
protocol = "direct"
# Ordered, and tried in order: direct first, a bridge as the fallback.
# `["direct", "via:<bridge>"]` suits a host that is only sometimes dialable.
reach = ["direct"]
workdir = "/srv/work"
tags = ["example"]
secret_backend = "file"
secret_ref = "~/.config/fleet/secrets/{name}.toml"
default_profile = "plain-ssh"
"""


